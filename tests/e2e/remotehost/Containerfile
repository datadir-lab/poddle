# A container that plays a "remote host": sshd (root, key-only) + a rootful
# podman API socket, so poddle's connection-aware provider can drive it over
# ssh://root@host. Rootful avoids the rootless UID/linger fragility of nested
# podman.
FROM quay.io/podman/stable

ARG PUBKEY

RUN dnf install -y openssh-server && ssh-keygen -A \
 && mkdir -p /root/.ssh \
 && printf '%s\n' "$PUBKEY" > /root/.ssh/authorized_keys \
 && chmod 700 /root/.ssh && chmod 600 /root/.ssh/authorized_keys \
 && sed -i 's/^#\?PermitRootLogin.*/PermitRootLogin prohibit-password/' /etc/ssh/sshd_config

EXPOSE 22

# rootful podman API socket + sshd in the foreground
CMD ["bash", "-lc", "podman system service --time=0 unix:///run/podman/podman.sock & exec /usr/sbin/sshd -D -e"]
