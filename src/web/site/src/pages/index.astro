---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import Feature from '../components/Feature.astro';
import Step from '../components/Step.astro';
import Button from '../components/Button.astro';
import compare from '../data/compare.json';

// Workflows shown in the auto-rotating "How it works" carousel.
const flows = [
  {
    key: 'Interactive sandbox',
    sub: 'A fully-authed shell with no key inside it. Spin up, work, tear down.',
    steps: [
      { t: 'Add an identity', c: 'poddle identity add work' },
      { t: 'Spin up a pod', c: 'poddle up my-sandbox --identity work' },
      { t: 'Work, then tear down', c: 'poddle down my-sandbox' },
    ],
  },
  {
    key: 'Headless task',
    sub: "Hand an agent a job and walk away - it runs in a fresh pod that's gone when it's done.",
    steps: [
      { t: 'Run an agent headless', c: 'poddle task "add tests for parseConfig" --identity ci' },
      { t: "Follow it (or don't)", c: 'poddle logs poddle-task-9f2a --follow' },
      { t: 'Pod torn down after', c: 'poddle down poddle-task-9f2a' },
    ],
  },
  {
    key: 'Remote host',
    sub: 'Run against any machine over SSH. The broker stays put, so your keys never travel.',
    steps: [
      { t: 'Point at a host', c: 'export PODDLE_HOST=ssh://you@build-box' },
      { t: 'Same commands, remotely', c: 'poddle up my-sandbox --identity work' },
      { t: 'Keys stay on your machine', c: 'poddle down my-sandbox' },
    ],
  },
  {
    key: 'Governed',
    sub: 'Pin an egress policy, run under it, and prove exactly what happened.',
    steps: [
      { t: 'Spin up under a policy', c: 'poddle up api --policy ci --identity work' },
      { t: 'Hand off a governed run', c: 'poddle task "triage flaky tests" --template ci' },
      { t: 'Audit and verify', c: 'poddle dashboard --open' },
    ],
  },
];
---
<Base title="poddle - secret-safe sandboxes for coding agents">
  <Hero />

  <Section eyebrow="The problem" title="Coding agents want your keys. Don’t give them any.">
    <div class="fmap">
      <div class="fmap__row">
        <div class="fmap__h">
          <span class="fmap__tag fmap__tag--bad">Without poddle</span>
          <span class="fmap__note">Your agent runs on your machine with your real key in reach - and any secret already in the prompt travels raw, straight to the provider.</span>
        </div>
        <div class="fmap__track">
          <div class="fnode">
            <span class="fnode__top"><img class="fnode__i" src="/icons/laptop.svg" alt="" width="18" height="18" />Your computer</span>
            <ul class="nstat"><li class="bad">Agent sees your key</li><li class="bad">Agent reads your secrets</li></ul>
          </div>
          <div class="hop hop--one">
            <div class="lane"><span class="pill pill--danger"><i class="picon picon--key"></i>Key + secrets, raw</span><i class="ldot ldot--danger"></i></div>
          </div>
          <div class="fnode fnode--muted">
            <span class="fnode__top"><span class="provx"><img src="/icons/anthropic.svg" alt="" style="animation-delay:0s" /><img src="/icons/openai.svg" alt="" style="animation-delay:2s" /><img src="/icons/deepseek.svg" alt="" style="animation-delay:4s" /><img src="/icons/googlegemini.svg" alt="" style="animation-delay:6s" /><img src="/icons/mistralai.svg" alt="" style="animation-delay:8s" /><img src="/icons/meta.svg" alt="" style="animation-delay:10s" /><img src="/icons/perplexity.svg" alt="" style="animation-delay:12s" /><img src="/icons/ollama.svg" alt="" style="animation-delay:14s" /></span>Provider</span>
            <ul class="nstat"><li class="bad">Gets your key</li><li class="bad">Gets your secrets</li></ul>
          </div>
        </div>
      </div>

      <div class="fmap__row">
        <div class="fmap__h">
          <span class="fmap__tag fmap__tag--good">With poddle</span>
          <span class="fmap__note">Work fans out to isolated pods that hold only a revocable handle. At the broker the real key is injected on the wire and stray secrets are scrubbed from the body - so nothing sensitive ever leaves the pod.</span>
        </div>
        <div class="fmap__track">
          <div class="fnode">
            <span class="fnode__top"><img class="fnode__i" src="/icons/user.svg" alt="" width="18" height="18" />You</span>
          </div>
          <div class="hop hop--one"><div class="lane"><span class="pill"><i class="picon picon--msg"></i>Prompt</span><i class="ldot"></i></div></div>
          <div class="podbox">
            <span class="podbox__cap">self-hosted / cloud</span>
            <div class="fpods">
              <div class="fpod"><img class="fpod__i" src="/favicon.svg" alt="" width="18" height="18" /><span class="fpod__t">Pod</span><span class="size" style="--d:9s"><span>weak</span><span>strong</span></span><span class="meter"><span class="meter__bar"></span></span></div>
              <div class="fpod"><img class="fpod__i" src="/favicon.svg" alt="" width="18" height="18" /><span class="fpod__t">Pod</span><span class="size" style="--d:13s"><span>weak</span><span>strong</span></span><span class="meter"><span class="meter__bar meter__bar--b"></span></span></div>
              <div class="fpod"><img class="fpod__i" src="/favicon.svg" alt="" width="18" height="18" /><span class="fpod__t">Pod</span><span class="size" style="--d:17s"><span>weak</span><span>strong</span></span><span class="meter"><span class="meter__bar meter__bar--c"></span></span></div>
            </div>
          </div>
          <div class="hop">
            <div class="lane"><span class="pill pill--handle"><i class="picon picon--ticket"></i>poddle_…</span><i class="ldot"></i></div>
            <div class="lane"><span class="pill pill--leak"><i class="picon picon--file"></i>AKIA…</span><i class="ldot ldot--danger" style="animation-delay:.8s"></i></div>
          </div>
          <div class="fcluster">
          <div class="fnode fnode--broker">
            <span class="fnode__top"><img class="fnode__i" src="/icons/shield.svg" alt="" width="18" height="18" />Broker</span>
            <ul class="nstat"><li class="ok">Injects provider key</li><li class="ok">Injects connector keys</li><li class="ok">Scrubs body secrets</li><li class="ok">Enforces egress policy</li></ul>
          </div>
          <div class="fconns">
            <svg class="ffan" width="152" height="28" viewBox="0 0 152 28" aria-hidden="true"><path class="ffan__line" d="M76 0 L12 28 M76 0 L44 28 M76 0 L76 28 M76 0 L108 28 M76 0 L140 28" /><circle class="sig" r="2.7" style="offset-path:path('M76 0 L12 28');animation-delay:0s" /><circle class="sig" r="2.7" style="offset-path:path('M76 0 L44 28');animation-delay:.35s" /><circle class="sig" r="2.7" style="offset-path:path('M76 0 L76 28');animation-delay:.7s" /><circle class="sig" r="2.7" style="offset-path:path('M76 0 L108 28');animation-delay:1.05s" /><circle class="sig" r="2.7" style="offset-path:path('M76 0 L140 28');animation-delay:1.4s" /></svg>
            <div class="fconns__row">
              <span class="fcirc"><img src="/icons/github.svg" alt="GitHub" /></span>
              <span class="fcirc"><img src="/icons/woodpecker.svg" alt="Woodpecker" /></span>
              <span class="fcirc"><img src="/icons/postgresql.svg" alt="Postgres" /></span>
              <span class="fcirc"><img src="/icons/amazonwebservices.svg" alt="AWS" /></span>
              <span class="fcirc"><img src="/icons/slack.svg" alt="Slack" /></span>
            </div>
            <span class="fconns__cap">Brokered connectors</span>
          </div>
          </div>
          <div class="hop">
            <div class="lane"><span class="pill pill--real"><i class="picon picon--key"></i>Provider key</span><i class="ldot"></i></div>
            <div class="lane"><span class="pill pill--clean"><i class="picon picon--file"></i>«redacted»</span><i class="ldot" style="animation-delay:.8s"></i></div>
          </div>
          <div class="fnode fnode--muted">
            <span class="fnode__top"><span class="provx"><img src="/icons/anthropic.svg" alt="" style="animation-delay:0s" /><img src="/icons/openai.svg" alt="" style="animation-delay:2s" /><img src="/icons/deepseek.svg" alt="" style="animation-delay:4s" /><img src="/icons/googlegemini.svg" alt="" style="animation-delay:6s" /><img src="/icons/mistralai.svg" alt="" style="animation-delay:8s" /><img src="/icons/meta.svg" alt="" style="animation-delay:10s" /><img src="/icons/perplexity.svg" alt="" style="animation-delay:12s" /><img src="/icons/ollama.svg" alt="" style="animation-delay:14s" /></span>Provider</span>
            <ul class="nstat"><li class="ok">Valid auth</li><li class="ok">Clean body</li></ul>
          </div>
        </div>
      </div>
    </div>
    <div class="fcompare">
      <div class="fcompare__col">
        <h4 class="fcompare__h">Without poddle</h4>
        <ul class="nstat">
          <li class="bad">The local agent can read your key and your repo secrets</li>
          <li class="bad">Your key and those secrets travel raw to the provider</li>
          <li class="bad">The provider ends up with your real key and your secrets</li>
        </ul>
      </div>
      <div class="fcompare__col">
        <h4 class="fcompare__h">With poddle</h4>
        <ul class="nstat">
          <li class="ok">Pods run in a self-hosted or cloud sandbox and hold only a revocable handle</li>
          <li class="ok">The broker injects the provider key and each connector credential</li>
          <li class="ok">Secrets in the request body are scrubbed to «redacted:poddle»</li>
          <li class="ok">The provider gets valid auth and a clean body - your key never leaves the broker</li>
        </ul>
      </div>
    </div>
  </Section>

  <Section eyebrow="Why poddle" title="Secretless, governed, and provably audited.">
    <div class="fgroups">
      <div class="fgroup">
        <p class="fgroup__label">Secretless &amp; isolated</p>
        <div class="fgrid">
          <Feature icon="shield" title="Secretless by construction">
            A broker issues revocable handles; the real secret never enters the pod.
          </Feature>
          <Feature icon="cube" title="Isolated, disposable pods">
            Podman-backed sandboxes, isolated per project - clean on every spin-up, gone on teardown.
          </Feature>
        </div>
      </div>

      <div class="fgroup">
        <p class="fgroup__label">Governed &amp; audited</p>
        <div class="fgrid">
          <Feature icon="funnel" title="Governable">
            Pin each pod to a named egress policy - allowlist the hosts it may reach, deny the rest, down to the HTTP method - and the broker enforces it on every request. SSO/SCIM and DORA / AI-Act controls are on the roadmap.
          </Feature>
          <Feature icon="file" title="Auditable">
            The broker keeps a tamper-evident, hash-chained record of every request, redaction, and handle - verifiable end to end and secret-free by construction (no bodies, no keys). Prove exactly what your agents did.
          </Feature>
          <Feature icon="user" title="Per-person, revocable access">
            Every pod runs under a real identity, so what an agent did ties back to a person - and its credentials revoke at the broker in one call. Offboard a teammate or rotate a key and the pod is locked out instantly.
          </Feature>
        </div>
      </div>

      <div class="fgroup">
        <p class="fgroup__label">Built for real work</p>
        <div class="fgrid">
          <Feature icon="layers" title="Reproducible lab templates">
            Pick a lab and go - podman, toolchains, and services preinstalled, interactive or headless. Spin the same environment every time, or publish your own blueprint.
          </Feature>
          <Feature icon="gauge" title="Performance on demand">
            Start small and let poddled auto-grow a pod when it nears its memory limit; burst to a stronger shell for a headless task and drop back after. Size for the common case, not the peak.
          </Feature>
          <Feature icon="plug" title="Bring your own agent">
            A harness registry - claude-code today; codex, aider, pi, and local planned.
          </Feature>
        </div>
      </div>
    </div>
  </Section>

  <Section eyebrow="Providers &amp; harnesses" title="Bring your provider. Bring your harness.">
    <p class="prose">
      Poddle wires your coding agent to your model provider through the broker - the harness
      installs itself in the pod, and authentication syncs to your identity. No keys to copy,
      nothing to configure: a remote dev environment that just works.
    </p>

    <p class="ilabel">Providers</p>
    <div class="chips">
      <a class="chip" href="https://www.anthropic.com" target="_blank" rel="noopener">
        <img class="chip__logo" src="/icons/anthropic.svg" alt="" width="18" height="18" />Anthropic<span class="chip__ext" aria-hidden="true">↗</span>
      </a>
    </div>
    <p class="glabel">Planned</p>
    <div class="chips chips--planned">
      <span class="chip"><img class="chip__logo" src="/icons/local.svg" alt="" width="18" height="18" />Local</span>
      <span class="chip chip--soon">more coming</span>
    </div>

    <p class="ilabel">Harnesses</p>
    <div class="chips">
      <a class="chip" href="https://github.com/anthropics/claude-code" target="_blank" rel="noopener">
        <img class="chip__logo" src="/icons/claude.svg" alt="" width="18" height="18" />Claude Code<span class="chip__ext" aria-hidden="true">↗</span>
      </a>
    </div>
    <p class="glabel">Planned</p>
    <div class="chips chips--planned">
      <a class="chip" href="https://pi.dev" target="_blank" rel="noopener">
        <img class="chip__logo" src="/icons/pi.svg" alt="" width="18" height="18" />Pi<span class="chip__ext" aria-hidden="true">↗</span>
      </a>
      <a class="chip" href="https://github.com/openai/codex" target="_blank" rel="noopener">
        <img class="chip__logo" src="/icons/openai.svg" alt="" width="18" height="18" />Codex<span class="chip__ext" aria-hidden="true">↗</span>
      </a>
      <a class="chip" href="https://github.com/google-gemini/gemini-cli" target="_blank" rel="noopener">
        <img class="chip__logo" src="/icons/googlegemini.svg" alt="" width="18" height="18" />Gemini<span class="chip__ext" aria-hidden="true">↗</span>
      </a>
      <a class="chip" href="https://aider.chat" target="_blank" rel="noopener">
        <span class="chip__mark">Ai</span>Aider<span class="chip__ext" aria-hidden="true">↗</span>
      </a>
      <a class="chip" href="https://opencode.ai" target="_blank" rel="noopener">
        <img class="chip__logo" src="/icons/opencode.svg" alt="" width="18" height="18" />OpenCode<span class="chip__ext" aria-hidden="true">↗</span>
      </a>
    </div>
  </Section>

  <Section eyebrow="Connectors" title="Connect your world - without handing over a key.">
    <p class="prose">
      Connect forges, pipelines, secrets, cloud, databases, and more - wired into a pod through
      the broker and authed on the wire, so the pod never sees a token.
    </p>
    <div class="conns">
      <span class="conn"><img class="conn__i" src="/icons/github.svg" alt="" width="30" height="30" />GitHub</span>
      <span class="conn"><img class="conn__i" src="/icons/woodpecker.svg" alt="" width="30" height="30" />Woodpecker</span>
      <span class="conn"><img class="conn__i" src="/icons/vault.svg" alt="" width="30" height="30" />Vault</span>
      <span class="conn"><img class="conn__i" src="/icons/amazonwebservices.svg" alt="" width="30" height="30" />AWS</span>
      <span class="conn"><img class="conn__i" src="/icons/postgresql.svg" alt="" width="30" height="30" />Postgres</span>
      <span class="conn"><img class="conn__i" src="/icons/slack.svg" alt="" width="30" height="30" />Slack</span>
    </div>
    <p class="conn-more"><a href="/connectors">See all connectors →</a></p>
  </Section>

  <Section id="how-it-works" eyebrow="How it works" title="One broker, every workflow.">
    <div class="flows" data-flows>
      <div class="flows__tabs" role="tablist" aria-label="Workflows">
        {flows.map((f, i) => (
          <button class:list={['flows__tab', i === 0 && 'is-active']} type="button" role="tab" id={`flowtab-${i}`} aria-controls={`flowpanel-${i}`} aria-selected={i === 0 ? 'true' : 'false'} data-i={i}>
            <span>{f.key}</span>
            <span class="flows__bar" aria-hidden="true"></span>
          </button>
        ))}
      </div>
      {flows.map((f, i) => (
        <div class:list={['flows__panel', i === 0 && 'is-active']} id={`flowpanel-${i}`} role="tabpanel" aria-labelledby={`flowtab-${i}`} tabindex="0" data-i={i}>
          <p class="flows__sub">{f.sub}</p>
          <ol class="steps">
            {f.steps.map((s, k) => <Step n={k + 1} title={s.t} code={s.c} />)}
          </ol>
        </div>
      ))}
    </div>
  </Section>

  <Section eyebrow="Dashboard" title="Provable after the fact.">
    <p class="prose">
      Every brokered request, redaction, and handle lands in a tamper-evident, hash-chained log -
      secret-free by construction (no bodies, no keys). Watch it live, filter by pod or decision,
      and verify the whole chain in one click.
    </p>
    <figure class="shot">
      <img class="shot__img" src="/dashboard-audit.png" width="1240" height="800" loading="lazy" decoding="async"
        alt="poddle dashboard audit view: a hash-chained table of brokered requests, each tagged allow, redact, deny, or block per pod and destination" />
      <figcaption class="shot__cap">The audit view in the built-in dashboard - self-host it or use the managed cloud.</figcaption>
    </figure>
  </Section>

  <Section eyebrow="How poddle compares" title="Why not just isolate, or just store the key?">
    <p class="prose">
      Isolation and secret managers each solve half of it. Poddle is the only approach that keeps
      the real secret out of the workload entirely - injected on the wire, scrubbed from outbound
      traffic, and provable after the fact.
    </p>
    <div class="cmp-cards">
      {compare.summary.map((s) => (
        <div class="cmp-card">
          <h3 class="cmp-card__h">{s.h}</h3>
          <p class="cmp-card__p">{s.p}</p>
        </div>
      ))}
    </div>
    <p class="conn-more"><a href="/compare">See the full comparison →</a></p>
  </Section>

  <Section title="Give your agents a room of their own.">
    <div class="closing">
      <p class="closing__lead">
        Secretless by construction, isolated per task, and provable after the fact. Start free in
        the cloud, or self-host the open-source broker - the same guarantees either way.
      </p>
      <div class="closing__cta">
        <Button href="/cloud" variant="primary">Start free</Button>
        <Button href="/docs" variant="ghost">Self-host it <span aria-hidden="true">→</span></Button>
      </div>
      <ul class="closing__reassure">
        <li>Free tier at launch</li>
        <li>No credit card</li>
        <li>Open source</li>
        <li>Self-host anytime</li>
      </ul>
    </div>
  </Section>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-flows]');
      if (!root) return;
      const tabs = Array.from(root.querySelectorAll('.flows__tab'));
      const panels = Array.from(root.querySelectorAll('.flows__panel'));
      function show(n) {
        tabs.forEach((t, k) => { const a = k === n; t.classList.toggle('is-active', a); t.setAttribute('aria-selected', a ? 'true' : 'false'); });
        panels.forEach((p, k) => p.classList.toggle('is-active', k === n));
      }
      tabs.forEach((t, k) => t.addEventListener('click', () => show(k)));
      // Standard tablist keyboard nav; no auto-rotation - the reader drives it.
      root.addEventListener('keydown', (e) => {
        const i = tabs.indexOf(document.activeElement);
        if (i === -1 || (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft')) return;
        e.preventDefault();
        const n = (i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length;
        tabs[n].focus();
        show(n);
      });
    })();
  </script>
</Base>

<style>
  .fgroups { display: flex; flex-direction: column; gap: 2.8rem; margin-top: 0.5rem; }
  .fgroup__label { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--faint); font-weight: 700; margin: 0 0 1.3rem; padding-bottom: 0.7rem; border-bottom: 1px solid var(--border); }
  .fgrid { display: grid; grid-template-columns: repeat(auto-fit, minmax(270px, 1fr)); gap: 1.7rem 2.6rem; }

  /* How it works - auto-rotating workflow carousel */
  .flows { margin-top: 0.6rem; }
  .flows__tabs { display: flex; flex-wrap: wrap; gap: 0.2rem 1.7rem; border-bottom: 1px solid var(--border); margin-bottom: 1.7rem; }
  .flows__tab { position: relative; border: 0; background: none; cursor: pointer; padding: 0.5rem 0 0.85rem; font: 600 0.95rem/1 var(--font-sans); color: var(--faint); transition: color 0.12s; }
  .flows__tab:hover { color: var(--muted); }
  .flows__tab.is-active { color: var(--ink); }
  .flows__bar { position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; }
  .flows__tab.is-active .flows__bar { background: var(--accent); }
  .flows__panel { display: none; }
  .flows__panel.is-active { display: block; animation: flowin 0.35s ease-out; }
  .flows__panel:focus-visible { outline: none; }
  .flows__sub { color: var(--muted); max-width: 62ch; margin: 0 0 0.8rem; }
  @keyframes flowin { from { opacity: 0; transform: translateY(5px); } to { opacity: 1; transform: none; } }
  .steps { margin: 0; padding: 0; }
  .closing { max-width: 62ch; }
  .closing__lead { font-size: var(--fs-lead); color: var(--muted); margin: 0 0 1.7rem; }
  .closing__cta { display: flex; flex-wrap: wrap; gap: 0.85rem; }
  .closing__reassure { list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem 1.4rem; margin: 1.6rem 0 0; padding: 0; }
  .closing__reassure li { position: relative; padding-left: 1.45rem; color: var(--faint); font-size: 0.86rem; }
  .closing__reassure li::before { content: ""; position: absolute; left: 0; top: 0.08em; width: 15px; height: 15px; border-radius: 50%; background: #dff0e8 url(/icons/check.svg) center / 9px no-repeat; }
  .cmp-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 1.2rem; margin-top: 1.5rem; }
  .cmp-card { border: 1px solid var(--border); border-radius: 14px; background: #fff; padding: 1.2rem 1.25rem 1.3rem; }
  .cmp-card__h { font-size: 1rem; margin: 0 0 0.5rem; color: var(--ink); }
  .cmp-card__p { color: var(--muted); font-size: 0.9rem; line-height: 1.5; margin: 0; }
  .prose { color: var(--muted); max-width: 60ch; }

  /* Dashboard screenshot - a dark app shot framed against the cream page. */
  .shot { margin: 1.9rem 0 0; }
  .shot__img {
    width: 100%; height: auto; border-radius: 14px;
    border: 1px solid var(--border);
    box-shadow: 0 34px 60px -34px rgba(21, 20, 15, 0.5), 0 8px 22px -14px rgba(21, 20, 15, 0.3);
  }
  .shot__cap { margin-top: 0.9rem; font-size: 0.85rem; color: var(--faint); }
  .ilabel { font-size: var(--fs-eyebrow); text-transform: uppercase; letter-spacing: 0.14em; color: var(--faint); margin: 1.8rem 0 0.7rem; }
  .chips { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .chip { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.4rem 0.85rem 0.4rem 0.4rem; border: 1px solid var(--border); border-radius: 999px; background: #fff; color: var(--ink); font-size: 0.9rem; font-weight: 500; text-decoration: none; transition: border-color 0.12s, transform 0.12s; }
  a.chip:hover { border-color: var(--accent); transform: translateY(-1px); }
  .chip__mark { display: inline-flex; align-items: center; justify-content: center; width: 1.5rem; height: 1.5rem; border-radius: 999px; background: var(--surface); color: var(--accent); font-family: var(--font-serif); font-size: 0.85rem; line-height: 1; }
