---
import Base from '../../layouts/Base.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

type Post = CollectionEntry<'blog'>;
const posts = (await getCollection('blog'))
  .filter((p: Post) => !p.data.draft)
  .sort((a: Post, b: Post) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---
<Base title="Blog - poddle" description="Notes from the poddle team on secretless sandboxes for coding agents.">
  <section class="container blog">
    <p class="eyebrow">Blog</p>
    <h1 class="blog__title">Notes from the team.</h1>
    <p class="blog__lead">
      How poddle keeps secrets out of coding-agent sandboxes - the broker, the threat model, egress
      governance, and what we are building.
    </p>

    <ul class="blog__list">
      {posts.map((p: Post) => (
        <li class="blog__item">
          <a class="blog__link" href={`/blog/${p.id}`}>
            <time class="blog__date" datetime={p.data.pubDate.toISOString()}>{fmt(p.data.pubDate)}</time>
            <h2 class="blog__h">{p.data.title}</h2>
            <p class="blog__desc">{p.data.description}</p>
          </a>
        </li>
      ))}
      {posts.length === 0 && <li class="blog__empty">No posts yet - check back soon.</li>}
    </ul>

    <p class="blog__rss"><a href="/rss.xml">RSS feed</a></p>
  </section>
</Base>
<style>
  .blog { padding-block: clamp(2.5rem, 6vw, 4rem) var(--space-section); max-width: 52rem; }
  .blog__title { font-size: var(--fs-h2); margin: 1rem 0 0; }
  .blog__lead { color: var(--muted); font-size: var(--fs-lead); max-width: 54ch; margin: 1.1rem 0 0; }
  .blog__list { list-style: none; margin: 2.6rem 0 0; padding: 0; }
  .blog__item { border-top: 1px solid var(--border); }
  .blog__item:last-child { border-bottom: 1px solid var(--border); }
  .blog__link { display: block; padding: 1.6rem 0; text-decoration: none; }
  .blog__date { font-size: 0.8rem; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--faint); }
  .blog__h { font-family: var(--font-serif); font-weight: 400; font-size: 1.6rem; line-height: 1.14; letter-spacing: -0.01em; color: var(--ink); margin: 0.5rem 0 0; }
  .blog__link:hover .blog__h { color: var(--accent); }
  .blog__desc { color: var(--muted); font-size: 0.98rem; line-height: 1.55; margin: 0.5rem 0 0; max-width: 62ch; }
  .blog__empty { padding: 2rem 0; color: var(--faint); }
  .blog__rss { margin-top: 2.2rem; }
  .blog__rss a { font-weight: 600; font-size: 0.9rem; }
</style>
