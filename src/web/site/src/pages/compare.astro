---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import compare from '../data/compare.json';

const { intro, columns, rows, notes } = compare;
const LABEL: Record<string, string> = {
  yes: 'Yes',
  no: 'No',
  partial: 'Partial',
  na: 'Not applicable',
};
---
<Base
  title="How poddle compares - poddle"
  description="How poddle's secretless broker compares to raw agents, dev sandboxes, agent code sandboxes, and secret managers - the only approach that keeps the real secret out of the workload."
>
  <section class="container cmp-hero">
    <p class="eyebrow">Compare</p>
    <h1 class="cmp-title">How poddle compares.</h1>
    <p class="cmp-lead">{intro}</p>
    <div class="cmp-cta">
      <Button href="/cloud" variant="primary">Start free</Button>
      <Button href="/docs" variant="ghost">Self-host it <span aria-hidden="true">&rarr;</span></Button>
    </div>
  </section>

  <section class="container cmp-body">
    <div class="cmp-scroll">
      <table class="cmp">
        <thead>
          <tr>
            <th class="cmp__rowcap" scope="col"><span class="cmp__sronly">Capability</span></th>
            {columns.map((c) => (
              <th scope="col" class:list={['cmp__col', c.featured && 'cmp__col--f']}>
                <span class="cmp__name">{c.name}</span>
                <span class="cmp__sub">{c.sub}</span>
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => {
            const cells = r.cells as any;
            return (
              <tr>
                <th scope="row" class="cmp__rowcap">{r.cap}</th>
                {columns.map((c) => (
                  <td class:list={['cmp__cell', c.featured && 'cmp__cell--f']}>
                    <span class:list={['mk', `mk--${cells[c.key]}`]} role="img" aria-label={LABEL[cells[c.key]]}></span>
                  </td>
                ))}
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>

    <div class="cmp-legend">
      <span><i class="mk mk--yes"></i>Yes</span>
      <span><i class="mk mk--partial"></i>Partial</span>
      <span><i class="mk mk--no"></i>No</span>
    </div>

    <ul class="cmp-notes">
      {notes.map((n) => <li>{n}</li>)}
    </ul>
    <p class="cmp-foot">
      Comparison is by category and reflects each approach's primary design goal; individual
      products vary. Spot something out of date? <a href="mailto:hello@datadir.co">Tell us</a>.
    </p>
  </section>
</Base>

<style>
  .cmp-hero { padding-block: clamp(2.5rem, 6vw, 4.5rem) 0.5rem; }
  .cmp-title { font-size: var(--fs-hero); max-width: 16ch; margin: 1rem 0 0; }
  .cmp-lead { font-size: var(--fs-lead); color: var(--muted); max-width: 64ch; margin: 1.2rem 0 0; }
  .cmp-cta { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 1.8rem; }
  .cmp-body { padding-bottom: var(--space-section); }

  .cmp-scroll { overflow-x: auto; margin-top: 2.4rem; }
  .cmp { border-collapse: collapse; width: 100%; min-width: 760px; }
  .cmp th, .cmp td { padding: 0.85rem 1rem; text-align: center; border-bottom: 1px solid var(--border); }
  .cmp thead th { vertical-align: bottom; }
  .cmp__rowcap { text-align: left; font-weight: 500; color: var(--ink); font-size: 0.92rem; white-space: normal; min-width: 16rem; }
  .cmp__name { display: block; font-family: var(--font-serif); font-size: 1.15rem; color: var(--ink); line-height: 1.1; }
  .cmp__sub { display: block; font-size: 0.72rem; color: var(--faint); margin: 0.3rem auto 0; max-width: 15ch; line-height: 1.3; }
  .cmp__col--f { border-top: 2px solid var(--accent); }
  .cmp__col--f .cmp__name { color: var(--accent); }
  .cmp__col--f, .cmp__cell--f { background: rgba(47, 158, 111, 0.05); }
  .cmp tbody tr:last-child th, .cmp tbody tr:last-child td { border-bottom: none; }
  .cmp__sronly { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }

  .mk { display: inline-block; width: 20px; height: 20px; border-radius: 50%; background-repeat: no-repeat; background-position: center; position: relative; vertical-align: middle; }
  .mk--yes { background-color: #dff0e8; background-image: url(/icons/check.svg); background-size: 11px; }
  .mk--no { background-color: #f6dcd2; background-image: url(/icons/x.svg); background-size: 11px; }
  .mk--partial { background-color: #f3e7cf; }
  .mk--partial::after { content: ""; position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); width: 9px; height: 2px; border-radius: 2px; background: #b5892a; }
  .mk--na::after { content: ""; position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); width: 6px; height: 6px; border-radius: 50%; background: var(--border); }

  .cmp-legend { display: flex; flex-wrap: wrap; gap: 1.3rem; margin-top: 1.1rem; font-size: 0.82rem; color: var(--muted); }
  .cmp-legend span { display: inline-flex; align-items: center; gap: 0.45rem; }
  .cmp-legend .mk { width: 17px; height: 17px; }

  .cmp-notes { margin: 2rem 0 0; padding-left: 1.1rem; color: var(--muted); font-size: 0.86rem; line-height: 1.55; max-width: 82ch; }
  .cmp-notes li { margin: 0.4rem 0; }
  .cmp-foot { margin-top: 1.4rem; color: var(--faint); font-size: 0.82rem; max-width: 72ch; }
  .cmp-foot a { color: var(--muted); }
</style>
