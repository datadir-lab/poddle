---
import site from '../data/site.json';

// GitHub star badge for the header. The live count is fetched at build time
// (production only, so `astro dev` doesn't hit the API on every request) and
// baked into the static HTML. If the repo is private, unreachable, or the API
// is rate-limited, we render the badge with no number rather than a fake one -
// so a real count appears the moment site.githubRepo points at a public repo.
const repo = site.githubRepo;
const url = `https://github.com/${repo}`;

let stars: number | null = null;
if (import.meta.env.PROD) {
  try {
    const res = await fetch(`https://api.github.com/repos/${repo}`, {
      headers: { Accept: 'application/vnd.github+json' },
    });
    if (res.ok) {
      const data = await res.json();
      if (typeof data.stargazers_count === 'number') stars = data.stargazers_count;
    }
  } catch {
    // Offline build or rate limit: fall through and render without a count.
  }
}

const count =
  stars === null ? null : stars >= 1000 ? `${(stars / 1000).toFixed(1)}k` : String(stars);
---
<a
  class="ghstars"
  href={url}
  target="_blank"
  rel="noopener"
  aria-label={stars === null ? 'poddle on GitHub' : `poddle on GitHub, ${stars} stars`}
>
  <img class="ghstars__mark" src="/icons/github.svg" alt="" width="16" height="16" />
  <span class="ghstars__txt">GitHub</span>
  {count && (
    <span class="ghstars__count">
      <svg class="ghstars__star" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true">
        <path d="M8 1.4l1.96 3.97 4.38.64-3.17 3.09.75 4.36L8 11.9l-3.92 2.06.75-4.36L1.66 6.01l4.38-.64z" />
      </svg>
      {count}
    </span>
  )}
</a>
<style>
  .ghstars {
    display: inline-flex; align-items: center; gap: 0.4rem;
    padding: 0.32rem 0.62rem; border: 1px solid var(--border); border-radius: 999px;
    background: #fff; color: var(--muted); font-size: 0.85rem; font-weight: 500;
    text-decoration: none; white-space: nowrap; transition: border-color 0.12s, color 0.12s;
  }
  .ghstars:hover { border-color: var(--accent); color: var(--ink); }
  .ghstars__mark { width: 16px; height: 16px; object-fit: contain; }
  .ghstars__count {
    display: inline-flex; align-items: center; gap: 0.22rem;
    padding-left: 0.45rem; border-left: 1px solid var(--border);
    color: var(--ink); font-variant-numeric: tabular-nums;
  }
  .ghstars__star { fill: #e3b341; }

  /* In the mobile header the badge sits beside the CTA + hamburger, so drop the
     "GitHub" word and keep just the mark and the star count. */
  @media (max-width: 860px) {
    .ghstars { padding: 0.32rem 0.55rem; }
    .ghstars__txt { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
    .ghstars__count { padding-left: 0; border-left: 0; }
  }
</style>
