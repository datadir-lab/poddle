---
interface Props {
  title: string;
  icon?: keyof typeof ICONS;
}
const { title, icon } = Astro.props;

// Small line-icons (stroke = currentColor). Kept here so features stay a single
// component the tests can render.
const ICONS = {
  shield: 'M12 3 5 6v5c0 4.4 3 7.6 7 9 4-1.4 7-4.6 7-9V6l-7-3zM9.3 12l1.9 1.9L15 10.4',
  cube: 'M12 2.6 3.6 7.3v9.4L12 21.4l8.4-4.7V7.3L12 2.6zM12 12l8.4-4.7M12 12v9.4M12 12 3.6 7.3',
  funnel: 'M4 5h16l-6.2 7.2v5.3l-3.6 1.8v-7.1L4 5z',
  file: 'M14 3H7a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1V7l-4-4zM14 3v4h4M9.5 14l1.7 1.7L15 12',
  user: 'M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM5.5 20a6.5 6.5 0 0 1 13 0',
  layers: 'M12 3 3.5 7.6 12 12.2l8.5-4.6L12 3zM3.5 12 12 16.6 20.5 12',
  gauge: 'M4 15a8 8 0 0 1 16 0M12 15l3.6-3.4',
  plug: 'M9 2.5v4.5M15 2.5v4.5M7.5 7h9v3a4.5 4.5 0 0 1-9 0V7zM12 16v5.5',
};
const path = icon ? ICONS[icon] : null;
---
<div class="feature">
  {path && (
    <span class="feature__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d={path} /></svg>
    </span>
  )}
  <div class="feature__text">
    <h3 class="feature__title">{title}</h3>
    <p class="feature__body"><slot /></p>
  </div>
</div>
<style>
  .feature { display: flex; gap: 0.85rem; }
  .feature__icon { flex: none; display: inline-flex; align-items: center; justify-content: center; width: 2.15rem; height: 2.15rem; border-radius: 10px; background: var(--surface); color: var(--accent); }
  .feature__icon svg { width: 1.15rem; height: 1.15rem; }
  .feature__text { min-width: 0; }
  .feature__title { font-family: var(--font-sans); font-weight: 600; font-size: 1.05rem; line-height: 1.3; margin: 0.15rem 0 0.35rem; }
  .feature__body { color: var(--muted); margin: 0; font-size: 0.95rem; line-height: 1.5; }
</style>
